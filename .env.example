# LogSentry AI Environment Configuration
# Copy this file to .env and update with your values

# Flask Configuration
FLASK_ENV=development
# FLASK_ENV=production

# Secret Key (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=logsentry-secret-key-change-in-production

# Database URL
# SQLite (default)
DATABASE_URL=sqlite:///data/logsentry.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/logsentry

# API Configuration
API_KEY=logsentry-api-key-change-in-production

# Processing Configuration
WINDOW_MINUTES=5
QUEUE_MAXSIZE=10000
WORKER_THREADS=2

# Detection Thresholds
RULE_ERROR_THRESHOLD=5
RULE_CPU_THRESHOLD=80
RULE_MEM_THRESHOLD=85

# Alert Settings
ALERT_RETENTION_DAYS=30

# SSE Settings
SSE_RETRY_TIMEOUT=5000

# Server Configuration (for production)
# GUNICORN_WORKERS=4
# GUNICORN_BIND=0.0.0.0:5000
# GUNICORN_TIMEOUT=120
